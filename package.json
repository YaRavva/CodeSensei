    "appwrite:seed": "node --env-file-if-exists=.env.local scripts/appwrite/seed.mjs",
    "appwrite:emails": "node --env-file-if-exists=.env.local scripts/appwrite/emails.mjs",
    "appwrite:test-emails": "node --env-file-if-exists=.env.local scripts/appwrite/test-emails.mjs",
    "content:validate": "node --import tsx scripts/content/validate.ts",
    "content:sync": "node --env-file=.env.local --import tsx scripts/content/sync.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
